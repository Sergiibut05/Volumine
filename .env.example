# Supabase — Project Settings → API
#
# Las dos son PÚBLICAS: viajan al navegador y cualquiera puede leerlas del
# bundle. Lo que impide que sirvan para algo malo no es el secreto, es RLS
# (ver supabase/migrations/0001_charts.sql).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA pongas aquí la service_role. Se salta RLS entera. Si algún día hace
# falta (webhook de pagos, tareas administrativas), va en la configuración del
# servidor de despliegue y jamás en un archivo con prefijo NEXT_PUBLIC_.

# ── Facturación (opcional) ───────────────────────────────────────────────────
#
# SIN ESTAS TRES, el producto es gratis: no hay botones de pago y el webhook
# devuelve 404. Ponerlas es lo único que hace falta para empezar a cobrar.
#
# La `service_role` se SALTA RLS ENTERA. Nunca en un archivo con prefijo
# NEXT_PUBLIC_, nunca en código de cliente. Solo la usa el webhook, que corre en
# servidor (ADR 0007).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
#
# Solo hacen falta para cobrar. Sin ellas, /precios enseña el plan gratuito y
# las rutas de pago devuelven 503 en vez de reventar.
#
# Developers → API keys. La `sk_` NO lleva NEXT_PUBLIC_: si lo llevara viajaría
# al navegador y con ella se puede hacer cualquier cosa en la cuenta.
STRIPE_SECRET_KEY=sk_test_...
#
# Developers → Webhooks → el endpoint → Signing secret. Es lo ÚNICO que separa
# el webhook de un endpoint para regalarse suscripciones: ver el comentario de
# src/app/api/stripe/webhook/route.ts.
STRIPE_WEBHOOK_SECRET=whsec_...
#
# Supabase → Project Settings → API. La usa SOLO el webhook, que tiene que
# escribir el plan de alguien que no está presente y en una columna que RLS
# prohíbe tocar a propósito. Tampoco lleva NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
