# Supabase — Project Settings → API
#
# Las dos son PÚBLICAS: viajan al navegador y cualquiera puede leerlas del
# bundle. Lo que impide que sirvan para algo malo no es el secreto, es RLS
# (ver supabase/migrations/0001_charts.sql).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA pongas aquí la service_role. Se salta RLS entera. Si algún día hace
# falta (webhook de pagos, tareas administrativas), va en la configuración del
# servidor de despliegue y jamás en un archivo con prefijo NEXT_PUBLIC_.

# ── Facturación (opcional) ───────────────────────────────────────────────────
#
# SIN ESTAS TRES, el producto es gratis: no hay botones de pago y el webhook
# devuelve 404. Ponerlas es lo único que hace falta para empezar a cobrar.
#
# La `service_role` se SALTA RLS ENTERA. Nunca en un archivo con prefijo
# NEXT_PUBLIC_, nunca en código de cliente. Solo la usa el webhook, que corre en
# servidor (ADR 0007).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
