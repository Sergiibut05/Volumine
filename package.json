{
  "name": "voluma",
  "version": "0.1.0",
  "private": true,
  "description": "Gráficas 3D interactivas que se incrustan en cualquier sitio con un link",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-embed.mjs && node scripts/build-embed-fonts.mjs && next build",
    "start": "next start",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "og": "node scripts/og-image.mjs",
    "icons": "node scripts/icons.mjs",
    "x:banner": "node scripts/x-banner.mjs",
    "x:gif": "node scripts/x-gif.mjs",
    "x:video": "node scripts/x-video.mjs",
    "perf:embed": "node scripts/perf-embed.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "build:fonts": "node scripts/build-embed-fonts.mjs",
    "build:map": "node scripts/build-globe-map.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "@vercel/analytics": "^2.0.1",
    "lz-string": "^1.5.0",
    "motion": "^12.43.0",
    "next": "16.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.5.0",
    "three": "^0.180.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "gifenc": "^1.0.3",
    "prettier": "^3.6.2",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4",
